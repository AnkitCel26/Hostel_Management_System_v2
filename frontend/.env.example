VITE_GRAPHQL_URL=http://localhost:4001/graphql

# Supabase document storage (Phase 9). The tenant portal uploads files
# straight to Supabase and records only the resulting URL in the backend.
#
# Vite reads this file once at startup — restart `npm run dev` after editing,
# and never rename it to .env.local if you want the .env above to keep applying.
# Supabase Project Settings -> API.
#
#   VITE_SUPABASE_URL  — Project URL, e.g. https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY — the PUBLISHABLE key (sb_publishable_… or the
#                            legacy eyJ… anon key). Never the service_role key:
#                            it is a full-access secret and this file is shipped
#                            to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Storage bucket holding tenant documents. It must already exist and be PUBLIC:
# the app calls getPublicUrl() and persists that URL permanently, so a private
# bucket would make every stored link 404. Create it in Supabase -> Storage ->
# Buckets with a 5 MB file size limit and the MIME types
# image/png, image/jpeg, image/webp, application/pdf.
# Keep in sync with SUPABASE_DOCS_BUCKET in backend/.env.
VITE_SUPABASE_DOCS_BUCKET=tenant-documents
