{
  "name": "hostel-management-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "migration:generate": "npm run build && typeorm migration:generate -d dist/config/db.js",
    "migration:run": "npm run build && typeorm migration:run -d dist/config/db.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/config/db.js",
    "verify:entities": "ts-node --transpile-only src/scripts/verifyCoreEntities.ts",
    "verify:phase4": "ts-node --transpile-only src/scripts/verifyPhase4.ts",
    "verify:phase5": "ts-node --transpile-only src/scripts/verifyPhase5.ts",
    "verify:phase6": "ts-node --transpile-only src/scripts/verifyPhase6.ts",
    "verify:phase7": "ts-node --transpile-only src/scripts/verifyPhase7.ts",
    "verify:phase8": "ts-node --transpile-only src/scripts/verifyPhase8.ts",
    "verify:phase9": "ts-node --transpile-only src/scripts/verifyPhase9.ts",
    "verify:phase10": "ts-node --transpile-only src/scripts/verifyPhase10.ts",
    "seed:admin": "ts-node --transpile-only src/scripts/createAdmin.ts",
    "seed:demo": "ts-node --transpile-only src/scripts/seedDemoData.ts",
    "test": "echo \"No tests yet\""
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "graphql": "^16.9.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.16.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.26.0"
  }
}
