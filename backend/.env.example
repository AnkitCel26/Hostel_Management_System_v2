PORT=4001
NODE_ENV=development

# Use either DATABASE_URL or individual pg credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hostel_management_v2

# Frontend origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Auth placeholders (not used in Phase 1 business features yet)
JWT_SECRET=replace_me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_COOKIE_NAME=hm_access
JWT_REFRESH_COOKIE_NAME=hm_refresh

# Supabase document storage (Phase 9). Public values only — no secret is
# needed here, the browser uploads files with the publishable anon key.
# Used by `npm run seed:demo` and `npm run verify:phase9` so stored document
# URLs point at the real bucket instead of a placeholder host.
# Project Settings -> API -> Project URL.
SUPABASE_URL=
SUPABASE_DOCS_BUCKET=tenant-documents
